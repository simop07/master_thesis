@article{Ubaldi_2025,
  doi       = {10.1088/1748-0221/20/06/C06039},
  url       = {https://doi.org/10.1088/1748-0221/20/06/C06039},
  year      = {2025},
  month     = {06},
  publisher = {IOP Publishing},
  volume    = {20},
  number    = {06},
  pages     = {C06039},
  author    = {Ubaldi, G. and on behalf of the FOOT collaboration},
  title     = {Measurements of nuclear fragmentation cross sections with the FOOT experiment},
  journal   = {Journal of Instrumentation},
  abstract  = {Nuclear fragmentation processes significantly impact particle therapy and space radiation protection, where accurate cross section measurements are needed for refining treatment planning and shielding strategies. Despite extensive research efforts in recent years, experimental data remain limited for double-differential cross sections, particularly in the energy range of 100–1000 MeV/u. This gap affects the optimization of treatment plans, where nuclear interactions alter dose distributions and the development of spacecraft shielding, since fragmentation processes are a critical source of radiation exposure for astronauts. The main goal of the FOOT (FragmentatiOn Of Target) experiment is to tackle these needs by providing measurements of double differential fragmentation cross sections of light elements (Z≤10) in the energy range of interests in medical and space applications. Two different setups were designed for this scope and data have already been collected in several campaigns. An overview of the state of the art of the apparatus is described, focusing on features and performances of the detectors. Finally, the results of cross section measurements and fragment identification obtained with a 16O beam at 200 MeV/u and 400 MeV/u against C and C2H4 targets at the GSI facility are presented for both setups.}
}

