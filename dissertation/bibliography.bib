@article{HEINBOCKEL20111079,
  title    = {Comparison of the transport codes HZETRN, HETC and FLUKA for a solar particle event},
  journal  = {Advances in Space Research},
  volume   = {47},
  number   = {6},
  pages    = {1079--1088},
  year     = {2011},
  issn     = {0273-1177},
  doi      = {10.1016/j.asr.2010.11.012},
  url      = {https://www.sciencedirect.com/science/article/pii/S0273117710007398},
  author   = {John H. Heinbockel and Tony C. Slaba and Steve R. Blattnig and Ram K. Tripathi and Lawrence W. Townsend and Thomas Handler and Tony A. Gabriel and Lawrence S. Pinsky and Brandon Reddell and Martha S. Clowdsley and Robert C. Singleterry and John W. Norbury and Francis F. Badavi and Sukesh K. Aghara},
  keywords = {Space radiation, Transport codes, Solar particle event},
  abstract = {The protection of astronauts and instrumentation from galactic cosmic rays and solar particle events is one of the primary constraints associated with mission planning in low earth orbit or deep space. To help satisfy this constraint, several computational tools have been developed to analyze the effectiveness of various shielding materials and structures exposed to space radiation. These tools are now being carefully scrutinized through a systematic effort of verification, validation, and uncertainty quantification. In this benchmark study, the deterministic transport code HZETRN is compared to the Monte Carlo transport codes HETC-HEDS and FLUKA for a 30g/cm2 water target protected by a 20g/cm2 aluminum shield exposed to a parameterization of the February 1956 solar particle event. Neutron and proton fluences as well as dose and dose equivalent are compared at various depths in the water target. The regions of agreement and disagreement between the three codes are quantified and discussed, and recommendations for future work are given.}
}

