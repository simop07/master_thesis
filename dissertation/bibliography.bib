@article{Rabaglia_2026,
  doi       = {10.1088/1748-0221/21/03/C03013},
  url       = {https://doi.org/10.1088/1748-0221/21/03/C03013},
  year      = {2026},
  month     = {03},
  publisher = {IOP Publishing},
  volume    = {21},
  number    = {03},
  pages     = {C03013},
  author    = {Rabaglia, S. and on behalf of the FOOT collaboration},
  title     = {Development of a new Vertex Detector for the FOOT experiment},
  journal   = {Journal of Instrumentation},
  abstract  = {FOOT (FragmentatiOn Of Target) is a cutting-edge experiment in applied nuclear physics focused on the precise measurement of cross sections for nuclear fragmentation reactions involving light ions (A &lt; 20) in the 100–800 MeV/u energy range. These data are essential for improving predictive models in two key application areas: the particle therapy treatment planning and the evaluation of the best shielding material for human space missions, particularly for extended travel beyond low Earth orbit where radiation doses are lethal. Designed as a fixed-target experiment, detector's design allows for measurements in both direct and inverse kinematics and aims to achieve double differential cross sections with uncertainties below 5% for projectile fragmentation and 10% for target fragmentation. For future data acquisitions the experiment is upgrading the pixel Vertex Detector, particularly by increasing the volume of data that can be collected within a given time frame while maintaining high spatial resolution. Such improvements are crucial for achieving greater precision through enhanced statistical accuracy. The new Vertex Detector is based on MIMOSIS 2.1 sensors, that are monolithic chips with a thickness of 50 μm, that allows to minimize the multiple scattering, and an integration time approximately 40 times shorter than the old ones. These features, together with a large active area of approximately 4 cm2, allow to improve the overall experimental capabilities. Moreover, the upgraded Vertex Detector is expected to be capable of handling measurements involving much heavier ions, such as 56Fe, which are of critical relevance to space radiation protection studies. This contribution presents the detector design and the results of preliminary tests performed on a MIMOSIS sensor. In particular, validation tests will be discussed, along with initial measurements carried out using radioactive sources.}
}

@article{DEBOER2002163,
  title    = {Measurements with a CMOS pixel sensor in magnetic fields},
  journal  = {Nuclear Instruments and Methods in Physics Research Section A: Accelerators, Spectrometers, Detectors and Associated Equipment},
